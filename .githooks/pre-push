#!/usr/bin/env bash
# Refuse a direct push to main: changes go through a branch and a pull
# request, merged by squash after all checks have passed.
# This hook catches the mistake before it reaches the server.
# Enable it once per clone:
#
#     git config core.hooksPath .githooks
#
set -euo pipefail

protected='refs/heads/main'
while read -r _ _ remote_ref _; do
  if [ "$remote_ref" = "$protected" ]; then
    echo "Direct pushes to main are refused: push a branch and open a pull request." >&2
    echo "Merge only after all checks of the workflow \"PDF and checks\" pass." >&2
    exit 1
  fi
done
exit 0
